<?xml version="1.0" encoding="utf-8"?>
<!--
  V3 device layer. Same two capabilities the P0 spike proved:
    canRetrieveWindowContent  -> read rootInActiveWindow (the node tree)
    canPerformGestures        -> dispatchGesture (taps / swipes / swipe-to-react)
  Scoped to Instagram only (packageNames) so the service sees nothing else —
  the V3 plan's "do nothing off-app" posture (docs/V3_PLAN.md §6.7).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows|flagReportViewIds|flagIncludeNotImportantViews"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:notificationTimeout="100"
    android:packageNames="com.instagram.android"
    android:description="@string/a11y_description" />
